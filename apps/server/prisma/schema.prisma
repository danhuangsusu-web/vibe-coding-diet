generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DemoProfile {
  id               String       @id @default(cuid())
  name             String
  goalDirection    GoalDirection
  dailyCalorieMin  Int
  dailyCalorieMax  Int
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  mealRecords      MealRecord[]
}

model MealRecord {
  id              String       @id @default(cuid())
  profileId       String
  clientRequestId String       @unique
  sourceType      InputType
  sourceText      String?
  items           Json
  calorieMin      Int
  calorieMax      Int
  rating          MealRating
  reason          String
  adviceIds       AdviceId[]
  advice          String
  isDemo          Boolean      @default(false)
  modelVersion    String?
  ruleVersion     String
  createdAt       DateTime     @default(now())
  profile         DemoProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

enum GoalDirection {
  FAT_LOSS
  MAINTAIN
  MUSCLE_GAIN
}

enum AdviceId {
  REDUCE_RICE
  REDUCE_OILY_DISH
  REMOVE_SKIN
  SEPARATE_SAUCE
  DRAIN_OIL
  SWAP_FOR_VEGETABLE
  KEEP_CURRENT
}

enum InputType {
  IMAGE
  TEXT
}

enum MealRating {
  GREEN
  YELLOW
  RED
}
